NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://the-supplier-kaung-set.vercel.app (or your .com)
# Supabase Auth → Redirect URLs must include:
#   {NEXT_PUBLIC_SITE_URL}/auth/callback
#   {NEXT_PUBLIC_SITE_URL}/**
NEXT_PUBLIC_WHATSAPP_NUMBER=+959xxxxxxxxx
# GA4 Measurement ID only (gtag on the storefront)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin gate (middleware). Comma-separated emails for /admin and /dashboard.
ADMIN_EMAIL=admin@example.com

# Order emails (Resend)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=The supplier Kaung Set <onboarding@resend.dev>

# Discord webhooks (separate channels)
DISCORD_WEBHOOK_PRODUCT_REQUESTS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_BUG_REPORTS=https://discord.com/api/webhooks/...
